# Personal interactive Zsh configuration.
#
# Ordered modules keep related concerns together without altering the startup
# sequence or materially affecting latency.

[[ -o interactive ]] || return

# Ahead of the modules, not after them: every module guard below asks whether a
# command exists, and a tool that lives here would answer no if this ran last.
# That is the normal case on a distribution that packages less than Homebrew --
# Debian gets mise and uv from their upstream installers, which write here, and
# bat under the name the installer links here -- and mise in particular has to
# be visible to runtimes.zsh or no runtime is activated at all. The GNU
# directories environment.zsh prepends still land in front of this.
export PATH="$HOME/.local/bin:$PATH"

typeset _zsh_rc_dir=${${(%):-%N}:A:h}
source "$_zsh_rc_dir/modules/environment.zsh"
# runtimes.zsh installs mise's precmd hook, so it loads before the modules that
# expect a resolved runtime on PATH. It no longer has to follow prompt.zsh:
# that constraint existed because starship's init unconditionally assigns
# PROMPT, wiping the prefix pyenv-virtualenv prepended. mise exports VIRTUAL_ENV
# and PATH without touching PROMPT, so the two are independent again.
source "$_zsh_rc_dir/modules/runtimes.zsh"
source "$_zsh_rc_dir/modules/prompt.zsh"
source "$_zsh_rc_dir/modules/commands.zsh"
source "$_zsh_rc_dir/modules/completion.zsh"
source "$_zsh_rc_dir/modules/node-and-tools.zsh"
source "$_zsh_rc_dir/modules/plugins.zsh"
source "$_zsh_rc_dir/modules/interaction.zsh"
unset _zsh_rc_dir

# Load machine-specific overrides after all shared modules.
[[ -r "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"
