#!/usr/bin/env bash

# Bootstrap a host from this repository. Existing files are moved into
# ~/.dotfiles-backups/<timestamp>/ first.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
backup_root="$HOME/.dotfiles-backups/$(date +%Y%m%d-%H%M%S)"
install_dependencies=1
install_plugins=1

usage() {
  cat <<'EOF'
Usage: install [--links-only] [--skip-plugins]

By default this installs dependencies, links dotfiles, and restores shell and
Vim plugins. --links-only only creates/preserves links and local configuration.
--skip-plugins still installs dependencies but does not fetch plugin sources.
EOF
}

for argument in "$@"; do
  case "$argument" in
    --links-only)
      install_dependencies=0
      install_plugins=0
      ;;
    --skip-plugins)
      install_plugins=0
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$argument" >&2
      usage >&2
      exit 2
      ;;
  esac
done

backup_and_link() {
  local source="$1" target="$2" backup

  mkdir -p "$(dirname "$target")"
  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    printf 'Already linked: %s\n' "$target"
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    backup="$backup_root/${target#"$HOME"/}"
    mkdir -p "$(dirname "$backup")"
    mv "$target" "$backup"
    printf 'Backed up: %s -> %s\n' "$target" "$backup"
  fi

  ln -s "$source" "$target"
  printf 'Linked: %s -> %s\n' "$target" "$source"
}

# Set one key in an INI file that cannot be linked, because its program writes
# the whole file back and the file also holds settings that differ per host.
# The active or commented line for the key in the section is replaced; a
# missing key or section is added. An empty section means the keys before the
# first section header. A symlinked file is left alone.
set_ini_key() {
  local file="$1" section="$2" key="$3" value="$4" tmp

  if [[ -L "$file" ]]; then
    printf 'Not editing a symlink: %s\n' "$file" >&2
    return
  fi
  mkdir -p "$(dirname "$file")"
  [[ -e "$file" ]] || : >"$file"
  tmp="$(mktemp)"
  awk -v sec="[$section]" -v key="$key" -v val="$value" '
    function add() { if (insec && !done) { print key "=" val; done = 1 } }
    BEGIN { if (sec == "[]") insec = seen = 1 }
    /^\[.*\]$/ { add(); insec = ($0 == sec); if (insec) seen = 1; print; next }
    insec && !done && index($0, key "=") && $0 ~ ("^(#[ \t]*)?" key "=") {
      print key "=" val; done = 1; next
    }
    { print }
    END { add(); if (!done) { if (!seen) print sec; print key "=" val } }
  ' "$file" >"$tmp"
  if cmp -s "$tmp" "$file"; then
    printf 'Already set: %s=%s in %s\n' "$key" "$value" "$file"
  else
    # Write in place, so the file keeps its permissions.
    cat "$tmp" >"$file"
    printf 'Set: %s=%s in %s\n' "$key" "$value" "$file"
  fi
  rm -f "$tmp"
}

# fcitx5 binds Shift_L to AltTriggerKeys by default. That key only goes back
# to the input method that it left, so it cannot activate a context that
# starts inactive. With ActiveByDefault=False every new context starts
# inactive, and Shift_L did nothing in a new window. So Shift_L becomes a
# trigger key, and AltTriggerKeys becomes empty. The trigger keys differ per
# host, so Shift_L is added to the list and the other keys stay. The list is
# the active one, else fcitx5's commented defaults, uncommented, else those
# defaults, written out.
fcitx5_shift_toggles() {
  local file="$1" defaults tmp

  if [[ -L "$file" ]]; then
    printf 'Not editing a symlink: %s\n' "$file" >&2
    return
  fi
  if [[ $(uname -s) == Darwin ]]; then
    defaults="Control+Shift_L Zenkaku_Hankaku Hangul"
  else
    defaults="Control+space Zenkaku_Hankaku Hangul"
  fi
  mkdir -p "$(dirname "$file")"
  [[ -e "$file" ]] || : >"$file"
  tmp="$(mktemp)"
  awk -v defaults="$defaults" '
    function keep(line, eq) {
      eq = index(line, "=")
      if (substr(line, 1, eq - 1) + 0 > max) max = substr(line, 1, eq - 1) + 0
      if (substr(line, eq + 1) == "Shift_L") has = 1
    }
    function flush() {
      if (inlist && !has) print max + 1 "=Shift_L"
      inlist = 0
    }
    # The first pass only learns whether an active or a commented list exists.
    FNR == NR {
      if ($0 == "[Hotkey/TriggerKeys]") active = 1
      if ($0 ~ /^#[ \t]*\[Hotkey\/TriggerKeys\]$/) commented = 1
      next
    }
    /^\[.*\]$/ {
      flush()
      dropping = ($0 == "[Hotkey/AltTriggerKeys]")
      if (dropping) next
      if ($0 == "[Hotkey/TriggerKeys]") { inlist = 1; has = 0; max = -1 }
      print
      next
    }
    # Drop an active AltTriggerKeys list: its header, its keys, and the blank
    # line after it. The comments of the next section stay.
    dropping && /^[0-9]+=/ { next }
    dropping && /^[ \t]*$/ { dropping = 0; next }
    dropping { dropping = 0 }
    inlist && /^[0-9]+=/ { keep($0); print; next }
    !active && !uncommented && /^#[ \t]*\[Hotkey\/TriggerKeys\]$/ {
      print "[Hotkey/TriggerKeys]"
      uncommented = 1; incomment = 1; inlist = 1; has = 0; max = -1
      next
    }
    incomment && /^#[ \t]*[0-9]+=/ {
      line = $0
      sub(/^#[ \t]*/, "", line)
      keep(line)
      print line
      next
    }
    incomment { incomment = 0; flush() }
    inlist && /^[ \t]*$/ { flush() }
    { print }
    END {
      flush()
      if (!active && !commented) {
        if (NR) print ""
        print "[Hotkey/TriggerKeys]"
        n = split(defaults, d, " ")
        for (i = 1; i <= n; i++) print i - 1 "=" d[i]
        print n "=Shift_L"
      }
    }
  ' "$file" "$file" >"$tmp"
  if cmp -s "$tmp" "$file"; then
    printf 'Already set: Shift_L in TriggerKeys in %s\n' "$file"
  else
    # Write in place, so the file keeps its permissions.
    cat "$tmp" >"$file"
    printf 'Set: Shift_L in TriggerKeys in %s\n' "$file"
  fi
  rm -f "$tmp"
  # Only after the list is uncommented: before that, the [Hotkey] section
  # runs on past its commented header, and the key would land in the list.
  set_ini_key "$file" Hotkey AltTriggerKeys ""
}

# tmux applies every configuration file it finds rather than stopping at the
# first, so a second file does not supplement ~/.tmux.conf -- it overrides
# every setting the two have in common. Omarchy installs one at the XDG path,
# which tmux reads last and which therefore wins. Move such a file aside; what
# was worth keeping from Omarchy's is already in tmux.conf here.
backup_conflicting() {
  local target="$1" reason="$2" backup

  [[ -e "$target" || -L "$target" ]] || return 0

  backup="$backup_root/${target#"$HOME"/}"
  mkdir -p "$(dirname "$backup")"
  mv "$target" "$backup"
  printf 'Moved aside, %s: %s -> %s\n' "$reason" "$target" "$backup"
}

vim_dir="$repo_dir/vim"
backup_and_link "$vim_dir" "$HOME/.vim"
backup_and_link "$vim_dir/vimrc" "$HOME/.vimrc"
backup_and_link "$vim_dir/nvim_init.vim" "$HOME/.config/nvim/init.vim"
backup_and_link "$repo_dir/tmux.conf" "$HOME/.tmux.conf"
backup_conflicting "$HOME/.config/tmux/tmux.conf" \
  "tmux reads it after ~/.tmux.conf and would override it"
backup_and_link "$repo_dir/zsh/zshrc" "$HOME/.zshrc"
backup_and_link "$repo_dir/zsh/zprofile" "$HOME/.zprofile"
backup_and_link "$repo_dir/zsh/plugins.txt" "$HOME/.zsh_plugins.txt"
backup_and_link "$repo_dir/zsh/abbr" "$HOME/.config/zsh-abbr/user-abbreviations"
backup_and_link "$repo_dir/starship/starship.toml" "$HOME/.config/starship.toml"
# Tools mise installs on every host, whatever the platform. Per-project
# versions come from each repository's own mise.toml and win over these.
backup_and_link "$repo_dir/mise/config.toml" "$HOME/.config/mise/config.toml"
# Linux only. macOS renders through Core Text, so even where a Homebrew
# package pulls fontconfig in, these rules would name faces that host does not
# have and resolve to nothing. Linking anyway would create the directory and
# stand ready to displace a fonts.conf written for something else, in exchange
# for no effect.
if [[ $OSTYPE == linux* ]]; then
  backup_and_link "$repo_dir/fontconfig/fonts.conf" "$HOME/.config/fontconfig/fonts.conf"
  # Compose sequences. Harmless where no compose key is bound, since nothing
  # reads the table until a compose key produces a sequence.
  backup_and_link "$repo_dir/xcompose" "$HOME/.XCompose"
fi

# Hyprland reads these after its own defaults and after the theme, so they are
# overrides rather than a replacement configuration -- Omarchy can keep
# improving what it ships without this repository having to track it. Guarded
# on the compositor rather than on Linux, because on a host without it these
# would only create a directory nothing reads.
if command -v Hyprland >/dev/null 2>&1; then
  backup_and_link "$repo_dir/omarchy/hypr/input.lua" "$HOME/.config/hypr/input.lua"
  backup_and_link "$repo_dir/omarchy/hypr/looknfeel.lua" "$HOME/.config/hypr/looknfeel.lua"
  backup_and_link "$repo_dir/omarchy/hypr/bindings.lua" "$HOME/.config/hypr/bindings.lua"
  backup_and_link "$repo_dir/omarchy/hypr/autostart.lua" "$HOME/.config/hypr/autostart.lua"
fi

# fcitx5 reads table behaviour from table/, not from inputmethod/, which is
# where the input method is registered rather than configured. fcitx5-macos
# reads the same paths but puts no fcitx5 on PATH, so it is found by its app.
has_fcitx5=0
if command -v fcitx5 >/dev/null 2>&1 || [[ -d "/Library/Input Methods/Fcitx5.app" ]]; then
  has_fcitx5=1
fi
if (( has_fcitx5 )); then
  backup_and_link "$repo_dir/fcitx5/wbx.conf" "$HOME/.config/fcitx5/table/wbx.conf"
  # A punctuation map in the data directory replaces the system one whole, so
  # the file carries every key, not only the quotes it changes.
  backup_and_link "$repo_dir/fcitx5/punc.mb.zh_CN" \
    "$HOME/.local/share/fcitx5/punctuation/punc.mb.zh_CN"
  # A new input context starts inactive, in the first input method of the
  # group (keyboard-us), and the trigger key switches it to wbx. fcitx5 writes
  # its global config back whenever any global option changes, and the file
  # holds hotkeys that differ per host, so only this key is managed.
  set_ini_key "$HOME/.config/fcitx5/config" Behavior ActiveByDefault False
  # Quotes and brackets are typed as a pair. conf/punctuation.conf also holds
  # the punctuation toggle key, which may differ per host, so only this key is
  # managed.
  set_ini_key "$HOME/.config/fcitx5/conf/punctuation.conf" "" \
    TypePairedPunctuationsTogether True
  fcitx5_shift_toggles "$HOME/.config/fcitx5/config"
  # The candidate window theme is fcitx5-macos's web panel. fcitx5 on Linux
  # draws with classicui, which reads a different theme format. The theme is
  # only made available here: it is chosen once in the Theme Editor.
  if [[ $(uname -s) == Darwin ]]; then
    backup_and_link "$repo_dir/fcitx5/theme/wetype.conf" \
      "$HOME/.local/share/fcitx5/theme/wetype.conf"
  fi
  # The table used to be wubi-large. Its link now points at a file that is gone.
  legacy="$HOME/.config/fcitx5/table/wubi-large.conf"
  if [[ -L "$legacy" && "$(readlink "$legacy")" == "$repo_dir/fcitx5/wubi-large.conf" ]]; then
    rm "$legacy"
    printf 'Removed stale link: %s\n' "$legacy"
  fi
fi

# Unlike the Hyprland files above, this replaces Omarchy's kitty.conf rather
# than layering over it -- kitty has no read-these-last override file. So
# improvements Omarchy makes to its template have to be picked up by hand;
# scripts/omarchy-review.sh is what surfaces them.
if command -v kitty >/dev/null 2>&1; then
  backup_and_link "$repo_dir/kitty/kitty.conf" "$HOME/.config/kitty/kitty.conf"
fi

# Helper the Hyprland bindings call by name, so it has to be on PATH rather than
# referenced by path from the configuration.
backup_and_link "$repo_dir/bin/peek-activate" "$HOME/.local/bin/peek-activate"


# Read by X11 clients only, so this is linked on the same condition as the rest
# of the desktop configuration rather than unconditionally.
if command -v Hyprland >/dev/null 2>&1; then
  backup_and_link "$repo_dir/xresources" "$HOME/.Xresources"
fi

# A clone of Omarchy's own tray widget, carrying three changes it does not have:
# the symbolic-icon fix from basecamp/omarchy#7290, an IPC target so it can be
# driven from the keyboard rather than only by hover, and a "drawer" setting
# that keeps every icon in the bar instead of folding all but the pinned ones
# away behind a chevron. Cloning is how Omarchy expects a built-in widget to be
# modified -- the packaged copy is replaced wholesale on update -- so the clone,
# not a patch, is what gets kept.
if [[ -d "$HOME/.config/omarchy" ]] || command -v omarchy >/dev/null 2>&1; then
  backup_and_link "$repo_dir/omarchy/plugins/eric.tray" \
    "$HOME/.config/omarchy/plugins/eric.tray"
  # The bar's view of the Claude Code sessions claude-tab-status records. The
  # plugin only appears in the bar once shell.json lists it; see the README.
  backup_and_link "$repo_dir/omarchy/plugins/eric.claude" \
    "$HOME/.config/omarchy/plugins/eric.claude"

  # The hook those records come from. Claude runs it by name, and the bar
  # widget's click runs it by name too, so it lives on PATH. It belongs to this
  # guard rather than to the machine at large: what reads its records is the
  # widget above and the Hyprland group-tab ring, and what it reads to write
  # them -- /proc, $XDG_RUNTIME_DIR -- is Linux's. A Mac sharing this
  # repository gets neither the script nor the hook registration below.
  backup_and_link "$repo_dir/bin/claude-tab-status" "$HOME/.local/bin/claude-tab-status"

  # What kitty draws for a Claude session: the status in its tab bar and in
  # each window's title. kitty looks for all three in its configuration
  # directory, wherever they are linked from, and claude-status.conf is what
  # kitty.conf's globinclude picks up -- so it is linked last. A running kitty
  # reloads on that file appearing and tries the watcher within a fraction of a
  # second; a watcher that is not there yet is recorded as failed and never
  # tried again until kitty restarts.
  if command -v kitty >/dev/null 2>&1; then
    backup_and_link "$repo_dir/omarchy/kitty/claude_status.py" "$HOME/.config/kitty/claude_status.py"
    backup_and_link "$repo_dir/omarchy/kitty/claude_title.py" "$HOME/.config/kitty/claude_title.py"
    backup_and_link "$repo_dir/omarchy/kitty/tab_bar.py" "$HOME/.config/kitty/tab_bar.py"
    backup_and_link "$repo_dir/omarchy/kitty/claude-status.conf" "$HOME/.config/kitty/claude-status.conf"
  fi

  # The ring and band over a working session's window, drawn by a Quickshell
  # instance of its own. Quickshell looks for named configurations under
  # ~/.config/quickshell/<name>, and the Hyprland autostart runs this one by
  # name.
  if command -v quickshell >/dev/null 2>&1; then
    backup_and_link "$repo_dir/omarchy/quickshell/claude-rings" \
      "$HOME/.config/quickshell/claude-rings"
  fi
fi

ssh_dir="$HOME/.ssh"
ssh_config="$ssh_dir/config"
ssh_local="$ssh_dir/config.local"
ssh_previous_umask="$(umask)"
umask 077
mkdir -p "$ssh_dir"
chmod 700 "$ssh_dir"

sanitize_ssh_config() {
  awk \
    -v home_dir="$HOME" \
    -v include_dir="$ssh_dir" \
    -v local_path="$ssh_local" \
    '
    function normalize_path(path, segments, normalized, count, depth, position) {
      if (path ~ /^~\//) {
        path = home_dir substr(path, 2)
      } else if (path ~ /^%d\//) {
        path = home_dir substr(path, 3)
      } else if (path ~ /^\$\{HOME\}\//) {
        path = home_dir substr(path, 8)
      } else if (path ~ /^\$HOME\//) {
        path = home_dir substr(path, 6)
      } else if (path ~ /^~/) {
        return path
      } else if (path !~ /^\//) {
        path = include_dir "/" path
      }

      count = split(path, segments, "/")
      depth = 0
      for (position = 1; position <= count; position++) {
        if (segments[position] == "" || segments[position] == ".") {
          continue
        }
        if (segments[position] == ".." && depth > 0) {
          depth--
          continue
        }
        normalized[++depth] = segments[position]
      }

      path = ""
      for (position = 1; position <= depth; position++) {
        path = path "/" normalized[position]
      }
      return path == "" ? "/" : path
    }

    function regex_literal(character) {
      if (character ~ /[][\\.^$*+?(){}|]/) {
        return "\\" character
      }
      return character
    }

    function glob_regex(pattern, result, position, character, closing,
                        scan, class_text) {
      result = ""
      for (position = 1; position <= length(pattern); position++) {
        character = substr(pattern, position, 1)
        if (character == "*") {
          result = result "[^/]*"
        } else if (character == "?") {
          result = result "[^/]"
        } else if (character == "[") {
          closing = 0
          for (scan = position + 1; scan <= length(pattern); scan++) {
            if (substr(pattern, scan, 1) == "]" && scan > position + 1) {
              closing = scan
              break
            }
          }
          if (closing == 0) {
            result = result "\\["
            continue
          }
          class_text = substr(pattern, position + 1, closing - position - 1)
          if (substr(class_text, 1, 1) == "!") {
            class_text = "^" substr(class_text, 2)
          }
          gsub(/\\/, "\\\\", class_text)
          result = result "[" class_text "]"
          position = closing
        } else if (character == "\\" && position < length(pattern)) {
          position++
          result = result regex_literal(substr(pattern, position, 1))
        } else {
          result = result regex_literal(character)
        }
      }
      return "^" result "$"
    }

    function is_local_include(candidate, normalized, normalized_local) {
      if (candidate ~ /^".*"$/) {
        candidate = substr(candidate, 2, length(candidate) - 2)
      }
      normalized = normalize_path(candidate)
      normalized_local = normalize_path(local_path)
      return normalized_local ~ glob_regex(normalized)
    }

    tolower($1) == "include" || tolower($1) ~ /^include=/ {
      output = $1
      first_field = 2
      kept_path = 0
      comment = ""

      if (tolower($1) ~ /^include=/) {
        output = substr($1, 1, index($1, "=") - 1)
        initial_candidate = substr($1, index($1, "=") + 1)
        if (initial_candidate != "" && !is_local_include(initial_candidate)) {
          output = output " " initial_candidate
          kept_path = 1
        }
      } else if ($2 == "=") {
        first_field = 3
      } else if (substr($2, 1, 1) == "=") {
        initial_candidate = substr($2, 2)
        first_field = 3
        if (initial_candidate != "" && !is_local_include(initial_candidate)) {
          output = output " " initial_candidate
          kept_path = 1
        }
      }

      for (field = first_field; field <= NF; field++) {
        token = $field
        if (substr(token, 1, 1) == "#") {
          comment = substr($0, index($0, token))
          break
        }
        if (is_local_include(token)) {
          continue
        }
        output = output " " token
        kept_path = 1
      }
      if (kept_path) {
        print output (comment == "" ? "" : " " comment)
      } else if (comment != "") {
        print comment
      }
      next
    }
    { print }
  ' "$1"
}

if [[ -L "$ssh_local" && ! -e "$ssh_local" ]]; then
  printf 'Broken SSH local configuration link: %s\n' "$ssh_local" >&2
  exit 1
fi

if [[ -e "$ssh_config" ]] &&
   [[ ! -L "$ssh_config" || "$(readlink "$ssh_config")" != "$repo_dir/ssh/config" ]]; then
  if [[ -L "$ssh_local" ]]; then
    printf 'Cannot merge %s into linked local configuration %s\n' \
      "$ssh_config" "$ssh_local" >&2
    exit 1
  fi
  if [[ -e "$ssh_local" && ! -f "$ssh_local" ]]; then
    printf 'SSH local configuration is not a regular file: %s\n' \
      "$ssh_local" >&2
    exit 1
  fi

  if [[ -f "$ssh_local" ]]; then
    chmod 600 "$ssh_local"
    printf '\n# Migrated from the previous ~/.ssh/config.\nHost *\n' >> "$ssh_local"
    sanitize_ssh_config "$ssh_config" >> "$ssh_local"
    printf 'Merged existing SSH configuration into: %s\n' "$ssh_local"
  else
    sanitize_ssh_config "$ssh_config" > "$ssh_local"
    printf 'Migrated existing SSH configuration: %s\n' "$ssh_local"
  fi
  chmod 600 "$ssh_local"
fi
backup_and_link "$repo_dir/ssh/config" "$ssh_config"
if [[ ! -e "$ssh_local" && ! -L "$ssh_local" ]]; then
  cp "$repo_dir/ssh/config.local.example" "$ssh_local"
  chmod 600 "$ssh_local"
  printf 'Created private SSH configuration template: %s\n' "$ssh_local"
else
  if [[ -f "$ssh_local" && ! -L "$ssh_local" ]]; then
    chmod 600 "$ssh_local"
  fi
  printf 'Kept private SSH configuration: %s\n' "$ssh_local"
fi

umask "$ssh_previous_umask"

git_local="$HOME/.config/git/local.gitconfig"
if [[ ! -e "$git_local" && ! -L "$HOME/.gitconfig" && -e "$HOME/.gitconfig" ]]; then
  mkdir -p "$(dirname "$git_local")"
  mv "$HOME/.gitconfig" "$git_local"
  printf 'Migrated machine-specific Git configuration: %s\n' "$git_local"
fi
backup_and_link "$repo_dir/git/config" "$HOME/.gitconfig"
# Git reads this path with no core.excludesFile to point at it.
backup_and_link "$repo_dir/git/ignore" "$HOME/.config/git/ignore"
if [[ ! -e "$git_local" ]]; then
  mkdir -p "$(dirname "$git_local")"
  cp "$repo_dir/git/local.gitconfig.example" "$git_local"
  chmod 600 "$git_local"
  printf 'Created private Git configuration template: %s\n' "$git_local"
else
  printf 'Kept private Git configuration: %s\n' "$git_local"
fi

local_zsh="$HOME/.config/zsh/local.zsh"
if [[ ! -e "$local_zsh" ]]; then
  mkdir -p "$(dirname "$local_zsh")"
  cp "$repo_dir/zsh/local.zsh.example" "$local_zsh"
  chmod 600 "$local_zsh"
  printf 'Created local configuration template: %s\n' "$local_zsh"
else
  printf 'Kept local configuration: %s\n' "$local_zsh"
fi

if (( install_dependencies )); then
  "$repo_dir/scripts/install-dependencies.sh"

  # Dependency installation can have created Homebrew in a child process;
  # initialise its PATH here as well so the validation and plugin phase see it.
  if ! command -v brew >/dev/null 2>&1; then
    for brew_candidate in /opt/homebrew/bin/brew "$HOME/.linuxbrew/bin/brew" /home/linuxbrew/.linuxbrew/bin/brew; do
      if [[ -x "$brew_candidate" ]]; then
        eval "$("$brew_candidate" shellenv)"
        break
      fi
    done
  fi
fi

# Debian installs bat as batcat, because bacula-console-qt already claims the
# name, and the shell configuration reaches for bat: as MANPAGER, as the ccat
# alias, and inside the ff() preview command, which fzf runs through sh where
# an alias would not resolve. One link on PATH answers all three. Only when
# nothing else provides bat -- a Homebrew or hand-built one is left alone.
# This comes after the dependency phase rather than with the other links: on a
# fresh Debian it is that phase which installs bat, and a guard asked before it
# runs sees no batcat and quietly links nothing.
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  backup_and_link "$(command -v batcat)" "$HOME/.local/bin/bat"
fi

# Down here with the other validations rather than beside the linking above,
# for the same reason as the bat link: a minimal Debian has no ssh until the
# dependency phase pulls openssh-client in as one of git's Recommends, so a
# guard asked earlier would skip this on a first install -- the one run where a
# broken ssh/config has not been proven to parse yet.
if command -v ssh >/dev/null 2>&1; then
  ssh -G -T -F "$ssh_dir/config" dotfiles-bootstrap.invalid >/dev/null
  printf 'SSH configuration check passed.\n'
fi

if command -v zsh >/dev/null 2>&1; then
  for zsh_config in "$repo_dir/zsh/zshrc" "$repo_dir/zsh/zprofile" "$repo_dir"/zsh/modules/*.zsh; do
    zsh -n "$zsh_config"
  done
  printf 'Zsh syntax check passed.\n'
fi

# Hyprland reports a Lua error by carrying on with the previous configuration,
# so a typo here is quiet. luac -p only parses; it writes nothing.
if command -v luac >/dev/null 2>&1; then
  for lua_config in "$repo_dir"/omarchy/hypr/*.lua; do
    luac -p -- "$lua_config"
  done
  printf 'Lua syntax check passed.\n'
fi

if command -v vim >/dev/null 2>&1; then
  vim -Nu NONE -n -es -c "source $vim_dir/vimrc" -c 'qa' || {
    printf 'Warning: Vim configuration smoke test failed; run scripts/check-vim-config.sh for details.\n' >&2
  }
fi

if (( install_plugins )); then
  "$repo_dir/scripts/install-plugins.sh"
fi

# Claude Code reads its hooks from its own settings file, which also carries
# choices made from inside Claude, so the hook entries are merged in rather
# than the file linked. Omarchy only, like the script the hooks call, and
# skipped where Claude has never been set up: the script would otherwise create
# the directory for a tool that is not there. Every Claude install has its own
# settings file, and the one on a Mac has hooks of its own that this repository
# has no business adding to.
if { [[ -d "$HOME/.config/omarchy" ]] || command -v omarchy >/dev/null 2>&1; } &&
  [[ -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ]]; then
  "$repo_dir/scripts/install-claude-hooks.sh"
fi

# iTerm2 drops Cmd+key events before they reach the input method, so the
# fcitx5 trigger key Super+space does nothing there. fcitx5/macos-hotkey.swift
# registers Cmd+Space as a system hotkey that runs fcitx5-remote -t instead.
# It is built here, rebuilt only when its source changes, and run by launchd.
install_fcitx5_hotkey() {
  local source="$repo_dir/fcitx5/macos-hotkey.swift"
  local binary="$HOME/.local/bin/fcitx5-hotkey"
  local stamp="$HOME/.local/state/dotfiles/fcitx5-hotkey.sha256"
  local label=com.eric.fcitx5-hotkey
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  local hash changed=0 tmp real_home

  mkdir -p "$(dirname "$binary")" "$(dirname "$stamp")" "$(dirname "$plist")" "$HOME/Library/Logs"
  hash="$(shasum -a 256 "$source" | cut -d' ' -f1)"
  if [[ ! -x "$binary" || "$(cat "$stamp" 2>/dev/null)" != "$hash" ]]; then
    swiftc -O -o "$binary.tmp" "$source"
    mv "$binary.tmp" "$binary"
    printf '%s\n' "$hash" >"$stamp"
    printf 'Built: %s\n' "$binary"
    changed=1
  fi

  tmp="$(mktemp)"
  cat >"$tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
        <string>$binary</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/fcitx5-hotkey.log</string>
</dict>
</plist>
PLIST
  if cmp -s "$tmp" "$plist"; then
    rm -f "$tmp"
  else
    chmod 644 "$tmp"
    mv "$tmp" "$plist"
    printf 'Wrote: %s\n' "$plist"
    changed=1
  fi

  # launchd jobs belong to the login session, not to $HOME. A run with a
  # temporary HOME, as scripts/check-bootstrap.sh does, must not replace the
  # running job with one whose files are about to be deleted.
  real_home="$(eval echo "~$(id -un)")"
  if [[ "$HOME" != "$real_home" ]]; then
    printf 'Not loading %s: HOME is not %s\n' "$label" "$real_home"
    return
  fi
  if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    if (( ! changed )); then
      printf 'Already running: %s\n' "$label"
      return
    fi
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  fi
  launchctl bootstrap "gui/$(id -u)" "$plist"
  printf 'Loaded: %s\n' "$label"
}

if (( has_fcitx5 )) && [[ $(uname -s) == Darwin ]]; then
  if command -v swiftc >/dev/null 2>&1; then
    install_fcitx5_hotkey
  else
    printf 'swiftc is missing, so Cmd+Space will not toggle fcitx5 in iTerm2. Install the Command Line Tools.\n' >&2
  fi
fi

# fcitx-dict syncs the fcitx5 word lists between hosts. The words are personal,
# so they live in that private repository rather than in this public one; this
# repository keeps only the preferences. A networked run clones it where the
# account can reach it. Installing it the first time is left to a person: a
# host that switches tables has to move its learned words over first, or
# fcitx-dict's first run would treat the old auto phrases as chosen words.
# Once installed, it is refreshed here like everything else.
fcitx_dict_dir="${FCITX_DICT_REPO:-$HOME/code/ai/fcitx-dict}"
fcitx_dict_url=git@github.com:freeyoung/fcitx-dict.git
if (( has_fcitx5 )); then
  if [[ -d "$fcitx_dict_dir/.git/fcitx-dict" ]]; then
    "$fcitx_dict_dir/bin/install" ||
      printf 'Warning: fcitx-dict install failed; run %s/bin/install for details.\n' "$fcitx_dict_dir" >&2
  else
    if [[ ! -e "$fcitx_dict_dir" ]] && (( install_dependencies )) &&
      GIT_SSH_COMMAND='ssh -o BatchMode=yes' git ls-remote "$fcitx_dict_url" >/dev/null 2>&1; then
      mkdir -p "$(dirname "$fcitx_dict_dir")"
      git clone -q "$fcitx_dict_url" "$fcitx_dict_dir"
      printf 'Cloned fcitx-dict: %s\n' "$fcitx_dict_dir"
    fi
    if [[ -d "$fcitx_dict_dir/.git" ]]; then
      printf 'fcitx-dict is not installed. Read %s/README.md, then run %s/bin/install.\n' \
        "$fcitx_dict_dir" "$fcitx_dict_dir"
    else
      printf 'fcitx-dict syncs the fcitx5 word lists. Clone %s into %s to use it.\n' \
        "$fcitx_dict_url" "$fcitx_dict_dir"
    fi
  fi
fi

printf '\nDone. Start a new Zsh session (exec zsh) to load the linked configuration.\n'
