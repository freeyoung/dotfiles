#!/usr/bin/env bash

# Bootstrap a host from this repository. Existing files are moved into
# ~/.dotfiles-backups/<timestamp>/ first.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
backup_root="$HOME/.dotfiles-backups/$(date +%Y%m%d-%H%M%S)"
install_dependencies=1
install_plugins=1

usage() {
  cat <<'EOF'
Usage: install [--links-only] [--skip-plugins]

By default this installs dependencies, links dotfiles, and restores shell and
Vim plugins. --links-only only creates/preserves links and local configuration.
--skip-plugins still installs dependencies but does not fetch plugin sources.
EOF
}

for argument in "$@"; do
  case "$argument" in
    --links-only)
      install_dependencies=0
      install_plugins=0
      ;;
    --skip-plugins)
      install_plugins=0
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$argument" >&2
      usage >&2
      exit 2
      ;;
  esac
done

backup_and_link() {
  local source="$1" target="$2" backup

  mkdir -p "$(dirname "$target")"
  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    printf 'Already linked: %s\n' "$target"
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    backup="$backup_root/${target#"$HOME"/}"
    mkdir -p "$(dirname "$backup")"
    mv "$target" "$backup"
    printf 'Backed up: %s -> %s\n' "$target" "$backup"
  fi

  ln -s "$source" "$target"
  printf 'Linked: %s -> %s\n' "$target" "$source"
}

# tmux applies every configuration file it finds rather than stopping at the
# first, so a second file does not supplement ~/.tmux.conf -- it overrides
# every setting the two have in common. Omarchy installs one at the XDG path,
# which tmux reads last and which therefore wins. Move such a file aside; what
# was worth keeping from Omarchy's is already in tmux.conf here.
backup_conflicting() {
  local target="$1" reason="$2" backup

  [[ -e "$target" || -L "$target" ]] || return 0

  backup="$backup_root/${target#"$HOME"/}"
  mkdir -p "$(dirname "$backup")"
  mv "$target" "$backup"
  printf 'Moved aside, %s: %s -> %s\n' "$reason" "$target" "$backup"
}

vim_dir="$repo_dir/vim"
backup_and_link "$vim_dir" "$HOME/.vim"
backup_and_link "$vim_dir/vimrc" "$HOME/.vimrc"
backup_and_link "$vim_dir/nvim_init.vim" "$HOME/.config/nvim/init.vim"
backup_and_link "$repo_dir/tmux.conf" "$HOME/.tmux.conf"
backup_conflicting "$HOME/.config/tmux/tmux.conf" \
  "tmux reads it after ~/.tmux.conf and would override it"
backup_and_link "$repo_dir/zsh/zshrc" "$HOME/.zshrc"
backup_and_link "$repo_dir/zsh/zprofile" "$HOME/.zprofile"
backup_and_link "$repo_dir/zsh/plugins.txt" "$HOME/.zsh_plugins.txt"
backup_and_link "$repo_dir/zsh/abbr" "$HOME/.config/zsh-abbr/user-abbreviations"
backup_and_link "$repo_dir/starship/starship.toml" "$HOME/.config/starship.toml"
# Tools mise installs on every host, whatever the platform. Per-project
# versions come from each repository's own mise.toml and win over these.
backup_and_link "$repo_dir/mise/config.toml" "$HOME/.config/mise/config.toml"
# Linux only. macOS renders through Core Text, so even where a Homebrew
# package pulls fontconfig in, these rules would name faces that host does not
# have and resolve to nothing. Linking anyway would create the directory and
# stand ready to displace a fonts.conf written for something else, in exchange
# for no effect.
if [[ $OSTYPE == linux* ]]; then
  backup_and_link "$repo_dir/fontconfig/fonts.conf" "$HOME/.config/fontconfig/fonts.conf"
  # Compose sequences. Harmless where no compose key is bound, since nothing
  # reads the table until a compose key produces a sequence.
  backup_and_link "$repo_dir/xcompose" "$HOME/.XCompose"
fi

# Hyprland reads these after its own defaults and after the theme, so they are
# overrides rather than a replacement configuration -- Omarchy can keep
# improving what it ships without this repository having to track it. Guarded
# on the compositor rather than on Linux, because on a host without it these
# would only create a directory nothing reads.
if command -v Hyprland >/dev/null 2>&1; then
  backup_and_link "$repo_dir/hypr/input.lua" "$HOME/.config/hypr/input.lua"
  backup_and_link "$repo_dir/hypr/looknfeel.lua" "$HOME/.config/hypr/looknfeel.lua"
  backup_and_link "$repo_dir/hypr/bindings.lua" "$HOME/.config/hypr/bindings.lua"
  backup_and_link "$repo_dir/hypr/autostart.lua" "$HOME/.config/hypr/autostart.lua"
fi

# fcitx5 reads table behaviour from table/, not from inputmethod/, which is
# where the input method is registered rather than configured.
if command -v fcitx5 >/dev/null 2>&1; then
  backup_and_link "$repo_dir/fcitx5/wubi-large.conf" \
    "$HOME/.config/fcitx5/table/wubi-large.conf"
fi

# Unlike the Hyprland files above, this replaces Omarchy's kitty.conf rather
# than layering over it -- kitty has no read-these-last override file. So
# improvements Omarchy makes to its template have to be picked up by hand;
# scripts/omarchy-review.sh is what surfaces them.
if command -v kitty >/dev/null 2>&1; then
  backup_and_link "$repo_dir/kitty/kitty.conf" "$HOME/.config/kitty/kitty.conf"
fi

# Helper the Hyprland bindings call by name, so it has to be on PATH rather than
# referenced by path from the configuration.
backup_and_link "$repo_dir/bin/peek-activate" "$HOME/.local/bin/peek-activate"

# Read by X11 clients only, so this is linked on the same condition as the rest
# of the desktop configuration rather than unconditionally.
if command -v Hyprland >/dev/null 2>&1; then
  backup_and_link "$repo_dir/xresources" "$HOME/.Xresources"
fi

# A clone of Omarchy's own tray widget, carrying two changes it does not have:
# the symbolic-icon fix from basecamp/omarchy#7290, and an IPC target so the
# drawer can be opened from the keyboard rather than only by hover. Cloning is
# how Omarchy expects a built-in widget to be modified -- the packaged copy is
# replaced wholesale on update -- so the clone, not a patch, is what gets kept.
if [[ -d "$HOME/.config/omarchy" ]] || command -v omarchy >/dev/null 2>&1; then
  backup_and_link "$repo_dir/omarchy/plugins/eric.tray" \
    "$HOME/.config/omarchy/plugins/eric.tray"
fi

ssh_dir="$HOME/.ssh"
ssh_config="$ssh_dir/config"
ssh_local="$ssh_dir/config.local"
ssh_previous_umask="$(umask)"
umask 077
mkdir -p "$ssh_dir"
chmod 700 "$ssh_dir"

sanitize_ssh_config() {
  awk \
    -v home_dir="$HOME" \
    -v include_dir="$ssh_dir" \
    -v local_path="$ssh_local" \
    '
    function normalize_path(path, segments, normalized, count, depth, position) {
      if (path ~ /^~\//) {
        path = home_dir substr(path, 2)
      } else if (path ~ /^%d\//) {
        path = home_dir substr(path, 3)
      } else if (path ~ /^\$\{HOME\}\//) {
        path = home_dir substr(path, 8)
      } else if (path ~ /^\$HOME\//) {
        path = home_dir substr(path, 6)
      } else if (path ~ /^~/) {
        return path
      } else if (path !~ /^\//) {
        path = include_dir "/" path
      }

      count = split(path, segments, "/")
      depth = 0
      for (position = 1; position <= count; position++) {
        if (segments[position] == "" || segments[position] == ".") {
          continue
        }
        if (segments[position] == ".." && depth > 0) {
          depth--
          continue
        }
        normalized[++depth] = segments[position]
      }

      path = ""
      for (position = 1; position <= depth; position++) {
        path = path "/" normalized[position]
      }
      return path == "" ? "/" : path
    }

    function regex_literal(character) {
      if (character ~ /[][\\.^$*+?(){}|]/) {
        return "\\" character
      }
      return character
    }

    function glob_regex(pattern, result, position, character, closing,
                        scan, class_text) {
      result = ""
      for (position = 1; position <= length(pattern); position++) {
        character = substr(pattern, position, 1)
        if (character == "*") {
          result = result "[^/]*"
        } else if (character == "?") {
          result = result "[^/]"
        } else if (character == "[") {
          closing = 0
          for (scan = position + 1; scan <= length(pattern); scan++) {
            if (substr(pattern, scan, 1) == "]" && scan > position + 1) {
              closing = scan
              break
            }
          }
          if (closing == 0) {
            result = result "\\["
            continue
          }
          class_text = substr(pattern, position + 1, closing - position - 1)
          if (substr(class_text, 1, 1) == "!") {
            class_text = "^" substr(class_text, 2)
          }
          gsub(/\\/, "\\\\", class_text)
          result = result "[" class_text "]"
          position = closing
        } else if (character == "\\" && position < length(pattern)) {
          position++
          result = result regex_literal(substr(pattern, position, 1))
        } else {
          result = result regex_literal(character)
        }
      }
      return "^" result "$"
    }

    function is_local_include(candidate, normalized, normalized_local) {
      if (candidate ~ /^".*"$/) {
        candidate = substr(candidate, 2, length(candidate) - 2)
      }
      normalized = normalize_path(candidate)
      normalized_local = normalize_path(local_path)
      return normalized_local ~ glob_regex(normalized)
    }

    tolower($1) == "include" || tolower($1) ~ /^include=/ {
      output = $1
      first_field = 2
      kept_path = 0
      comment = ""

      if (tolower($1) ~ /^include=/) {
        output = substr($1, 1, index($1, "=") - 1)
        initial_candidate = substr($1, index($1, "=") + 1)
        if (initial_candidate != "" && !is_local_include(initial_candidate)) {
          output = output " " initial_candidate
          kept_path = 1
        }
      } else if ($2 == "=") {
        first_field = 3
      } else if (substr($2, 1, 1) == "=") {
        initial_candidate = substr($2, 2)
        first_field = 3
        if (initial_candidate != "" && !is_local_include(initial_candidate)) {
          output = output " " initial_candidate
          kept_path = 1
        }
      }

      for (field = first_field; field <= NF; field++) {
        token = $field
        if (substr(token, 1, 1) == "#") {
          comment = substr($0, index($0, token))
          break
        }
        if (is_local_include(token)) {
          continue
        }
        output = output " " token
        kept_path = 1
      }
      if (kept_path) {
        print output (comment == "" ? "" : " " comment)
      } else if (comment != "") {
        print comment
      }
      next
    }
    { print }
  ' "$1"
}

if [[ -L "$ssh_local" && ! -e "$ssh_local" ]]; then
  printf 'Broken SSH local configuration link: %s\n' "$ssh_local" >&2
  exit 1
fi

if [[ -e "$ssh_config" ]] &&
   [[ ! -L "$ssh_config" || "$(readlink "$ssh_config")" != "$repo_dir/ssh/config" ]]; then
  if [[ -L "$ssh_local" ]]; then
    printf 'Cannot merge %s into linked local configuration %s\n' \
      "$ssh_config" "$ssh_local" >&2
    exit 1
  fi
  if [[ -e "$ssh_local" && ! -f "$ssh_local" ]]; then
    printf 'SSH local configuration is not a regular file: %s\n' \
      "$ssh_local" >&2
    exit 1
  fi

  if [[ -f "$ssh_local" ]]; then
    chmod 600 "$ssh_local"
    printf '\n# Migrated from the previous ~/.ssh/config.\nHost *\n' >> "$ssh_local"
    sanitize_ssh_config "$ssh_config" >> "$ssh_local"
    printf 'Merged existing SSH configuration into: %s\n' "$ssh_local"
  else
    sanitize_ssh_config "$ssh_config" > "$ssh_local"
    printf 'Migrated existing SSH configuration: %s\n' "$ssh_local"
  fi
  chmod 600 "$ssh_local"
fi
backup_and_link "$repo_dir/ssh/config" "$ssh_config"
if [[ ! -e "$ssh_local" && ! -L "$ssh_local" ]]; then
  cp "$repo_dir/ssh/config.local.example" "$ssh_local"
  chmod 600 "$ssh_local"
  printf 'Created private SSH configuration template: %s\n' "$ssh_local"
else
  if [[ -f "$ssh_local" && ! -L "$ssh_local" ]]; then
    chmod 600 "$ssh_local"
  fi
  printf 'Kept private SSH configuration: %s\n' "$ssh_local"
fi

if command -v ssh >/dev/null 2>&1; then
  ssh -G -T -F "$ssh_dir/config" dotfiles-bootstrap.invalid >/dev/null
  printf 'SSH configuration check passed.\n'
fi
umask "$ssh_previous_umask"

git_local="$HOME/.config/git/local.gitconfig"
if [[ ! -e "$git_local" && ! -L "$HOME/.gitconfig" && -e "$HOME/.gitconfig" ]]; then
  mkdir -p "$(dirname "$git_local")"
  mv "$HOME/.gitconfig" "$git_local"
  printf 'Migrated machine-specific Git configuration: %s\n' "$git_local"
fi
backup_and_link "$repo_dir/git/config" "$HOME/.gitconfig"
# Git reads this path with no core.excludesFile to point at it.
backup_and_link "$repo_dir/git/ignore" "$HOME/.config/git/ignore"
if [[ ! -e "$git_local" ]]; then
  mkdir -p "$(dirname "$git_local")"
  cp "$repo_dir/git/local.gitconfig.example" "$git_local"
  chmod 600 "$git_local"
  printf 'Created private Git configuration template: %s\n' "$git_local"
else
  printf 'Kept private Git configuration: %s\n' "$git_local"
fi

local_zsh="$HOME/.config/zsh/local.zsh"
if [[ ! -e "$local_zsh" ]]; then
  mkdir -p "$(dirname "$local_zsh")"
  cp "$repo_dir/zsh/local.zsh.example" "$local_zsh"
  chmod 600 "$local_zsh"
  printf 'Created local configuration template: %s\n' "$local_zsh"
else
  printf 'Kept local configuration: %s\n' "$local_zsh"
fi

if (( install_dependencies )); then
  "$repo_dir/scripts/install-dependencies.sh"

  # Dependency installation can have created Homebrew in a child process;
  # initialise its PATH here as well so the validation and plugin phase see it.
  if ! command -v brew >/dev/null 2>&1; then
    for brew_candidate in /opt/homebrew/bin/brew "$HOME/.linuxbrew/bin/brew" /home/linuxbrew/.linuxbrew/bin/brew; do
      if [[ -x "$brew_candidate" ]]; then
        eval "$("$brew_candidate" shellenv)"
        break
      fi
    done
  fi
fi

# Debian installs bat as batcat, because bacula-console-qt already claims the
# name, and the shell configuration reaches for bat: as MANPAGER, as the ccat
# alias, and inside the ff() preview command, which fzf runs through sh where
# an alias would not resolve. One link on PATH answers all three. Only when
# nothing else provides bat -- a Homebrew or hand-built one is left alone.
# This comes after the dependency phase rather than with the other links: on a
# fresh Debian it is that phase which installs bat, and a guard asked before it
# runs sees no batcat and quietly links nothing.
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  backup_and_link "$(command -v batcat)" "$HOME/.local/bin/bat"
fi

if command -v zsh >/dev/null 2>&1; then
  for zsh_config in "$repo_dir/zsh/zshrc" "$repo_dir/zsh/zprofile" "$repo_dir"/zsh/modules/*.zsh; do
    zsh -n "$zsh_config"
  done
  printf 'Zsh syntax check passed.\n'
fi

# Hyprland reports a Lua error by carrying on with the previous configuration,
# so a typo here is quiet. luac -p only parses; it writes nothing.
if command -v luac >/dev/null 2>&1; then
  for lua_config in "$repo_dir"/hypr/*.lua; do
    luac -p -- "$lua_config"
  done
  printf 'Lua syntax check passed.\n'
fi

if command -v vim >/dev/null 2>&1; then
  vim -Nu NONE -n -es -c "source $vim_dir/vimrc" -c 'qa' || {
    printf 'Warning: Vim configuration smoke test failed; run scripts/check-vim-config.sh for details.\n' >&2
  }
fi

if (( install_plugins )); then
  "$repo_dir/scripts/install-plugins.sh"
fi

printf '\nDone. Start a new Zsh session (exec zsh) to load the linked configuration.\n'
