# Shared command-line environment for macOS and Linuxbrew.
# Keep machine-specific applications and credentials out of this file.

# Shell integration and interactive tools.
brew "antidote"
brew "fzf"
brew "starship"
brew "zoxide"

# GNU userland: the shell configuration intentionally uses these variants.
brew "coreutils"
brew "gawk"
brew "grep"
brew "gnu-sed"

# Language runtimes. mise resolves every pinned version, so no per-language
# manager (fnm, pyenv, pyenv-virtualenv) and no separately installed Node are
# needed; see zsh/modules/runtimes.zsh. uv backs mise's virtualenv creation and
# is the Python package installer this configuration expects.
brew "mise"
brew "go"
brew "uv"

# Editors.
brew "neovim"
brew "vim"

# Other command-line tools.
brew "bat"
brew "git"
brew "ripgrep"
brew "kubectl"
brew "ouch"
brew "tmux"
