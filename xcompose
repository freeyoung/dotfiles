# Compose-key sequences. The compose key is bound in hypr/input.lua; on a
# non-Hyprland host, set it with setxkbmap or the desktop's keyboard settings.
#
# Run omarchy-restart-xcompose after editing this on Omarchy; elsewhere,
# restart the application, since Compose tables are read once at startup.

# The locale's own table first, so the standard sequences still work.
include "%L"

# Identification, for forms and sign-ups.
<Multi_key> <space> <n> : "Eric Qian"
<Multi_key> <space> <e> : "lavave@gmail.com"

# Emoji
