# Ghostty, set up like the kitty configuration next door, which copies iTerm2.
# Most of what kitty needed Python for is a setting here, so this file is short:
# what is left is the font, the colors and the behaviour, all of which mean the
# same thing on every desktop.
#
# install links this to ~/.config/ghostty/config wherever Ghostty is, with
# cc-status and the theme beside it, and links macos.conf or linux.conf next to
# it for what only one desktop wants. The last 2 lines here pull those in; the ?
# in front of each means the one that is not there is not an error.

# Colors, from the iTerm2 "Default" profile. The theme file is linked into
# ~/.config/ghostty/themes/, where Ghostty looks for a theme by name.
theme = My iTerm2

# Font. A value belongs here when it is true of both machines, and in the file
# each desktop pulls in at the end of this one when it is not. The family is
# true of both, so saying it twice would only be 2 places to forget. The size
# and the cut of the cell are not -- the 2 machines sit at different distances
# -- and neither is the Chinese fallback, which only the Mac has to name.
#
# The plain Nerd Font variant, not the Mono one, because that is what Omarchy
# can have: it depends on ttf-jetbrains-mono-nerd-basic, which carries the base
# family alone, and the Mono variant lives in the full ttf-jetbrains-mono-nerd,
# which conflicts with the basic one -- installing it would take the omarchy
# package's own dependency with it.
#
# Nothing is lost by matching that here. Nerd Fonts patches JetBrains Mono
# along 2 axes -- ligatures or NL, and Mono or Propo or neither -- and of the 6
# results the 4 that are not Propo are the same font for this setup. Measured,
# file against file: of the 12226 codepoints the Mono and the plain variant
# share, 24 differ in advance, all of them combining marks that Mono widens to
# a full cell and the plain one rightly leaves at 0. Every Nerd Font icon is
# the same width in both.
#
# Ghostty fits the icons itself either way: it carries the Nerd Fonts patcher's
# own per-codepoint scaling rules (src/font/nerd_font_attributes.zig, generated
# from nerd_font_codegen.py) and applies them to whatever face supplied the
# glyph.
#
# The 3 font-feature lines are how the ligatures are turned off. They say what
# is wanted whatever font is named, where the NL variant would only be a file
# that happens to lack the glyphs, to be remembered again the next time the
# face changes.
font-family = JetBrainsMono Nerd Font
font-feature = -calt
font-feature = -liga
font-feature = -dlig
window-inherit-font-size = false

# Cursor: a block that does not blink, as in iTerm2. Ghostty's shell
# integration would otherwise make it a bar at the prompt.
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# A transparent window, and cmd+u turns the transparency off and on.
background-opacity = 0.8

# The window.
window-padding-balance = true
# A new tab goes to the end of the bar, where iTerm2 puts one, rather than next
# to the tab it was opened from.
window-new-tab-position = end
quit-after-last-window-closed = true
confirm-close-surface = false
scrollback-limit = 100000000

# A new window, tab or split starts at home, not in the directory of the pane
# it came from.
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false

# Dim the panes that are not focused, like iTerm2's "Dim inactive split panes".
unfocused-split-opacity = 0.8
unfocused-split-fill = ffffff

# Select to copy, like iTerm2.
copy-on-select = clipboard

# Splits stay the same size, when one opens and when one closes. That is the
# default of the Ghostty this is written for, and nothing is written here for
# it, so stock Ghostty reads this file without complaining -- it just leaves the
# splits uneven.

# What only one desktop wants. Whichever of these is linked is read; the other
# is not there, which the ? allows.
config-file = ?macos.conf
config-file = ?linux.conf
