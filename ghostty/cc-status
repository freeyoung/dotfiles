#!/usr/bin/env python3
"""Claude Code hook for Ghostty: show what a session is doing.

Ghostty has no tab bar a script can draw in and no pane title bars, so the
state goes through the 2 channels a pane does own, and the terminal draws it:

  OSC 9;4  the progress report, which Ghostty shows on the tab (with a patched
           build) and as a bar along the top of the pane. Claude
           Code sends `working` itself; it has nothing for a prompt waiting to
           be answered, so this hook sends the pause state for that.

  OSC 4    the palette. Color 255, the last grayscale slot, is set to a value
           nothing draws with, and the patched Ghostty draws the colored dot of
           the tab from that mark. It is the only channel that tells a session
           with nothing to do from no session at all, so it has a color for
           that as well.

The detail text of a permission prompt has nowhere to go, unlike in kitty,
where the tab bar and the pane title bars show it.
"""
import datetime
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'claude'))
from session_state import END, IDLE, WAITING, WORKING, classify  # noqa: E402

RING = {
    WORKING: '\033]4;255;rgb:00/ff/01\007',
    WAITING: '\033]4;255;rgb:00/00/fe\007',
    IDLE: '\033]4;255;rgb:00/80/01\007',
}
RING_CLEAR = '\033]104;255\007'
# OSC 9;4: 3 is indeterminate and 4 is pause. Claude Code sends 3 itself while
# the model works and 0 when it stops, but a report that is not repeated goes
# stale -- after 15 seconds in Ghostty as it ships -- and a turn is quiet for
# longer than that, so working is sent again at every event that carries it.
# Nothing sends anything for a prompt waiting to be answered.
#
# None of these carries a number. A number is a percentage, and `4;0` is a
# paused job that has done nothing, which Ghostty draws as a bar of no width at
# all; with no number it draws the whole bar, which is what waiting means here.
PROGRESS = {WORKING: '\033]9;4;3\007', WAITING: '\033]9;4;4\007'}
PROGRESS_CLEAR = '\033]9;4;0\007'


def claude_tty() -> str:
    """The tty of the Claude Code process this hook was run by."""
    pid = os.getppid()
    for _ in range(8):
        try:
            out = subprocess.run(['ps', '-o', 'comm=,ppid=,tty=', '-p', str(pid)],
                                 capture_output=True, text=True, timeout=2).stdout.split()
        except (OSError, subprocess.SubprocessError):
            break
        if len(out) < 3:
            break
        command, parent, tty = out[0], out[1], out[2]
        if os.path.basename(command) == 'claude':
            return tty
        pid = int(parent)
    return ''


def write(text: str) -> str:
    """Send escape codes to the pane this hook runs in.

    /dev/tty is that pane whenever Claude Code passes its terminal on, which it
    does today. If it ever stops, the tty of the Claude process itself is the
    same pane, so that is tried next.

    Returns what it wrote to, or an empty string when it found nothing to write
    to, which is the one failure the log below cannot see any other way.
    """
    try:
        out = open('/dev/tty', 'w')
    except OSError:
        tty = claude_tty()
        if tty in ('??', ''):
            return ''
        try:
            out = open(f'/dev/{tty}', 'w')
        except OSError:
            return ''
    with out:
        out.write(text)
        out.flush()
        return getattr(out, 'name', '?')


def log(*fields: object) -> None:
    """A line per event, when CC_STATUS_LOG is set in the environment.

    What a tab shows is whatever event reached it last, and the tab keeps no
    history, so a tab left saying the wrong thing is a question about order:
    which events arrived, in which order, which of them said nothing, and which
    pane each one was written to. Nothing but a log can answer that.

    Off unless it is asked for, because the answer is worth a line on disk only
    while a question is open. A log that cannot be written is not worth failing
    a hook over, so every error here is dropped.
    """
    if not os.environ.get('CC_STATUS_LOG'):
        return
    path = os.path.expanduser('~/.cache/cc-status.log')
    stamp = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')[:-3]
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'a') as out:
            out.write(f'{stamp} pid={os.getpid():<7} ' + ' '.join(str(f) for f in fields) + '\n')
    except OSError:
        pass


def main() -> None:
    # Ghostty only. In another terminal the sequences would be noise, and kitty
    # has a hook of its own.
    if not os.environ.get('GHOSTTY_RESOURCES_DIR'):
        return
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return
    name = event.get('hook_event_name', '?')
    state, _ = classify(event)
    if state is None:
        log(f'{name:<20}', 'no change')
        return
    if state is END:
        target = write(RING_CLEAR + PROGRESS_CLEAR)
    else:
        target = write(RING[state] + PROGRESS.get(state, PROGRESS_CLEAR))
    log(f'{name:<20}', f'-> {state:<8}', target or 'NOWHERE')


if __name__ == '__main__':
    main()
